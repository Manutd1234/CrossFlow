  "methodology": {
    "methodology_version": "crossflow-corridor-map-hotspots-v1",
    "selection_limit": 30,
    "selection_formula": "0.45*corridor_pressure + 0.20*recurrence + 0.15*network_criticality + 0.10*demand_exposure + 0.10*evidence_confidence",
    "selection_weights": {
      "corridor_pressure": 0.45,
      "recurrence": 0.2,
      "network_criticality": 0.15,
      "demand_exposure": 0.1,
      "evidence_confidence": 0.1
    },
    "dynamic_congestion": {
      "formula": "corridor_weight*corridor_pressure + recurring_weight*recurring_pressure",
      "corridor_weight": "min(0.85, weighted_signal_confidence)",
      "recurring_weight": "1-corridor_weight",
      "active_peak_lift": 5.0
    },
    "source_confidence": {
      "tomtom_live_policy": 0.9,
      "simulated": 0.2
    },
    "tie_break": "selection_score_desc_then_zone_id_asc",
    "observed": false,
    "limitations": "Candidate locations, recurring scores, criticality and demand exposure are modelled planning inputs. Corridor flow may include provider data, but no zone is a direct observation."
  },
