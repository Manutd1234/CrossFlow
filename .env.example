# Server-only durability configuration. Never put either server credential in
# a VITE_ or NEXT_PUBLIC_ variable.
SUPABASE_URL=
# Preferred modern server-only credential. Legacy deployments may use the
# service-role key below instead; never expose either one to browser code.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Apply backend/data/ferry_freshness.sql for shared ferry verification. Apply
# backend/data/routing_intelligence.sql only when the optional durable traffic
# observation and shortcut review/approval store is required.

# The optional routing-intelligence schema is never probed just because ferry
# freshness uses the same Supabase project. Keep local until its SQL migration
# is applied; then set supabase in Preview/Production.
CROSSFLOW_ROUTING_INTELLIGENCE_STORE=local

# vercel.json pins this to 1 for every deployment. Keep 0 only for local
# committed-snapshot fallback, or set 1 locally to test the fail-closed path.
CROSSFLOW_REQUIRE_DURABLE_FERRY_FRESHNESS=0

# Only needed for an audited self-hosted Supabase-compatible HTTPS endpoint.
CROSSFLOW_SUPABASE_ALLOWED_HOST=

# --- Human sign-in for admins and drivers (backend/auth) --------------------
# Off until explicitly enabled, so a project without backend/auth/schema.sql
# applied keeps serving every public corridor, ferry and model endpoint.
# Set to `supabase` once the schema is applied. Values: disabled | supabase
CROSSFLOW_AUTH_MODE=disabled

# The browser-safe key, and the only Supabase credential that may appear in
# client code. It identifies the project; it grants nothing on its own, because
# row-level security decides what a request may read from the caller's own JWT.
# NEVER put SUPABASE_SECRET_KEY here or in any client-visible variable: the
# secret key bypasses row-level security entirely, which would let any signed-in
# driver read every other driver's journey while the app still looks correct.
SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may still call this SUPABASE_ANON_KEY; either is accepted.
SUPABASE_ANON_KEY=

# Local routing is the default and remains the critical-path fallback. The
# legacy `supabase` adapter is intentionally disabled because it cannot prove
# vehicle constraints. Use supabase_v2_constrained only after installing and
# validating a complete replacement RPC contract.
CROSSFLOW_ROUTE_PROVIDER=local

# Synchronous alternative-route search budgets. These affect only the bounded
# alternative search; the primary route remains outside these limits.
CROSSFLOW_ALTERNATIVE_MAX_SEARCHES=3
CROSSFLOW_ALTERNATIVE_TIME_BUDGET_MS=10000
CROSSFLOW_ALTERNATIVE_MAX_SETTLED_STATES=250000

# Local congestion-history storage. A normal file is single-host durable;
# serverless /tmp and the automatic in-memory fallback are explicitly ephemeral.
CROSSFLOW_HISTORY_DB=

# Typed spatial observations default to five years. The accepted range is
# 365..7300 days; retention cleanup never relabels synthetic data as observed.
CROSSFLOW_SPATIAL_HISTORY_RETENTION_DAYS=1825

# Identity of the audited producer bound to the admin-only observation API.
# The request body cannot self-declare a high-trust source. Supported values:
# loop_sensor, probe_gps, tomtom_live, verified_traffic_observation.
CROSSFLOW_TRAFFIC_INGEST_SOURCE=

# Immutable reviewer identity attached to shortcut approvals. This comes from
# deployment configuration, never the request body or shared admin token.
CROSSFLOW_SHORTCUT_REVIEWER_ID=

# Optional SQLite store for verified, exact-edge traversal learning.
CROSSFLOW_ROUTE_LEARNING_DB=

# Server-owned pinned-source JSON policy for crowd shortcut candidates. Blank
# disables source fetching. Audit every real URL before enabling it; incoming
# tips remain REVIEW_REQUIRED and cannot activate a graph edge.
CROSSFLOW_SHORTCUT_SOURCE_POLICY=
# Example shape (placeholder URL; do not enable unchanged):
# CROSSFLOW_SHORTCUT_SOURCE_POLICY={"schema_version":1,"sources":[{"source_id":"reviewed_batam_tips","pinned_urls":["https://tips.example.org/audited/batam-shortcuts.json"],"allowed_content_types":["application/json"],"confidence_ceiling":0.6}],"limits":{"max_document_bytes":262144,"max_documents_per_batch":20,"max_tips_per_document":64,"max_tips_per_batch":200,"max_excerpt_chars":320}}

# Protect backend ingestion, review/promotion, persistence-status and retraining
# operations. Send this value only in X-CrossFlow-Admin-Token; never expose it
# through a VITE_ or NEXT_PUBLIC_ variable and do not reuse a Supabase secret.
CROSSFLOW_ADMIN_TOKEN=

# Driver route retrieval. Configure this separately from the admin token; the
# route ID is a content identifier, not a credential.
CROSSFLOW_ROUTE_READ_TOKEN=
CROSSFLOW_ROUTE_DB=
